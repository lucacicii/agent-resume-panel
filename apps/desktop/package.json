{
  "name": "@agent-resume/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Resume Desktop (Electron) — Session OS + Memory",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/fix-node-pty.mjs && tsc -p tsconfig.json && node scripts/copy-renderer.cjs && node scripts/build-renderer-vendor.mjs",
    "dev": "npm run build && electron .",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@agent-resume/core": "0.1.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",

    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",

    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.6",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "electron": "^35.2.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
