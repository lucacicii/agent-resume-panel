{
  "name": "@agent-resume/core",
  "version": "0.1.0",
  "private": true,
  "author": "lucacicii",
  "license": "AGPL-3.0-only",
  "description": "Shared catalog, session sync, i18n, and notes core for Agent Resume Panel",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node ../../scripts/run-tsc.mjs --cwd . -p ./",
    "watch": "node ../../scripts/run-tsc.mjs --cwd . -p ./ -w",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}
