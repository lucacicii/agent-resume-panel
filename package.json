{
  "name": "agent-resume-panel-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "compile": "npm run build:core && npm run compile -w agent-resume-panel",
    "watch": "npm run watch -w agent-resume-panel",
    "build:core": "npm run build -w @agent-resume/core",
    "build:desktop": "npm run build -w @agent-resume/desktop",
    "pack:desktop": "npm run build:core && npm run pack:mac -w @agent-resume/desktop",
    "release:desktop:mac": "node scripts/release-desktop-mac.mjs",
    "dev:desktop": "npm run dev -w @agent-resume/desktop",
    "package": "npm run package -w agent-resume-panel",
    "install:local": "npm run install:local -w agent-resume-panel",
    "build:all": "npm run build:all -w agent-resume-panel",
    "build:openvsx": "npm run build:openvsx -w agent-resume-panel",
    "publish:openvsx": "npm run publish:openvsx -w agent-resume-panel",
    "test:menus": "npm run test:menus -w agent-resume-panel",
    "test:manifest": "npm run test:manifest -w agent-resume-panel",
    "test:vsix": "npm run test:vsix -w agent-resume-panel",
    "test:notes": "npm run test:notes -w agent-resume-panel",
    "i18n:check": "npm run i18n:check -w agent-resume-panel"
  }
}
