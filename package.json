{
  "name": "agent-resume-panel",
  "displayName": "Agent Resume Panel",
  "publisher": "thunder-luc",
  "description": "Browse, search, and resume Codex, Claude Code, Antigravity CLI, Grok Build, OpenCode, Pi, and Alma sessions from a VS Code sidebar — with project filters, favorites, native session rename, and read-only chat preview.",
  "version": "1.2.0",
  "icon": "resources/icon.png",
  "private": true,
  "author": "thunder-luc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thunder-luc/agent-resume-panel.git"
  },
  "homepage": "https://github.com/thunder-luc/agent-resume-panel#readme",
  "bugs": {
    "url": "https://github.com/thunder-luc/agent-resume-panel/issues"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:agentResume.sessions",
    "onCommand:agentResume.refresh",
    "onCommand:agentResume.search",
    "onCommand:agentResume.newSession",
    "onCommand:agentResume.openFolder",
    "onCommand:agentResume.openProject",
    "onCommand:agentResume.openInGhostty",
    "onCommand:agentResume.openInCodexApp",
    "onCommand:agentResume.openInClaudeCodePanel",
    "onCommand:agentResume.openInCodexIdePanel",
    "onCommand:agentResume.newCodexSession",
    "onCommand:agentResume.newClaudeSession",
    "onCommand:agentResume.newAgySession",
    "onCommand:agentResume.newGrokSession",
    "onCommand:agentResume.newOpenCodeSession",
    "onCommand:agentResume.newPiSession",
    "onCommand:agentResume.newAlmaSession",
    "onCommand:agentResume.newCodexAppSession",
    "onCommand:agentResume.favoriteProject",
    "onCommand:agentResume.unfavoriteProject",
    "onCommand:agentResume.configureProjectMenu",
    "onCommand:agentResume.newSessionFromEditor",
    "onCommand:agentResume.openSettings",
    "onCommand:agentResume.autoRenameSession"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:all": "node scripts/build-all.mjs",
    "package": "npm run compile && vsce package --no-dependencies",
    "install:local": "npm run package && node scripts/install-local.mjs",
    "publish:openvsx": "npm run build:all && npx --yes ovsx publish \"dist/agent-resume-panel-$(node -p \"require('./package.json').version\").vsix\""
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@types/vscode": "1.92.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "configuration": {
      "title": "Agent Resume Panel",
      "properties": {
        "agentResume.codexHome": {
          "type": "string",
          "default": "~/.codex",
          "description": "Codex home directory containing state_*.sqlite, session_index.jsonl, and history.jsonl."
        },
        "agentResume.claudeHome": {
          "type": "string",
          "default": "~/.claude",
          "description": "Claude Code home directory containing history.jsonl and projects."
        },
        "agentResume.antigravityHome": {
          "type": "string",
          "default": "~/.gemini",
          "description": "Antigravity data root. The extension scans antigravity-cli and antigravity subdirectories for sessions."
        },
        "agentResume.grokHome": {
          "type": "string",
          "default": "~/.grok",
          "description": "Grok Build home directory containing sessions."
        },
        "agentResume.almaDataDir": {
          "type": "string",
          "default": "~/Library/Application Support/alma",
          "description": "Alma data directory containing chat_threads.db. On macOS this is usually ~/Library/Application Support/alma."
        },
        "agentResume.opencodeHome": {
          "type": "string",
          "default": "~/.local/share/opencode",
          "description": "OpenCode data directory containing opencode.db."
        },
        "agentResume.piHome": {
          "type": "string",
          "default": "~/.pi/agent",
          "description": "Pi agent home directory containing sessions."
        },
        "agentResume.maxItems": {
          "type": "number",
          "default": 500,
          "minimum": 20,
          "maximum": 5000,
          "description": "Maximum number of sessions to load into the panel."
        },
        "agentResume.terminalMode": {
          "type": "string",
          "enum": [
            "newPerSession"
          ],
          "default": "newPerSession",
          "description": "Terminal launch behavior. The first version opens one terminal per resumed session."
        },
        "agentResume.terminalLocation": {
          "type": "string",
          "enum": [
            "editorBeside",
            "panel"
          ],
          "default": "editorBeside",
          "description": "Where VS Code integrated resume terminals should open."
        },
        "agentResume.enableVsCodeTerminalImagesHint": {
          "type": "boolean",
          "default": true,
          "description": "Show a one-time hint about VS Code terminal image support and the Ghostty fallback."
        },
        "agentResume.ghosttyExecutable": {
          "type": "string",
          "default": "Ghostty",
          "description": "Ghostty app name on macOS or ghostty CLI executable/path used by Open in Ghostty."
        },
        "agentResume.ghosttyLaunchMode": {
          "type": "string",
          "enum": [
            "pasteCommand",
            "copyCommand",
            "executeCommand"
          ],
          "default": "pasteCommand",
          "description": "How Open in Ghostty starts a session. pasteCommand opens Ghostty, pastes the copied resume command, and presses Enter without using Ghostty's execute-command path."
        },
        "agentResume.ghosttyAutoPasteDelayMs": {
          "type": "number",
          "default": 900,
          "minimum": 100,
          "maximum": 5000,
          "description": "Delay before auto-pasting the resume command into Ghostty when ghosttyLaunchMode is pasteCommand."
        },
        "agentResume.showArchivedCodex": {
          "type": "boolean",
          "default": false,
          "description": "Show archived Codex threads."
        },
        "agentResume.showSubagentCodex": {
          "type": "boolean",
          "default": false,
          "description": "Show Codex subagent threads in the panel (threads whose source field contains subagent)."
        },
        "agentResume.showArchivedOpenCode": {
          "type": "boolean",
          "default": false,
          "description": "Show archived OpenCode sessions."
        },
        "agentResume.showSubagentGrok": {
          "type": "boolean",
          "default": false,
          "description": "Show Grok Build subagent sessions (session_kind: subagent) in the panel. Ephemeral subagent shells with no title and at most one message are always hidden."
        },
        "agentResume.hideCronAlma": {
          "type": "boolean",
          "default": true,
          "description": "Hide Alma cron threads (titles starting with ⏰ Cron:)."
        },
        "agentResume.hideChannelAlma": {
          "type": "boolean",
          "default": true,
          "description": "Hide Alma channel threads (WeChat, Telegram, Discord, Slack)."
        },
        "agentResume.showIncognitoAlma": {
          "type": "boolean",
          "default": false,
          "description": "Show Alma incognito threads in the panel."
        },
        "agentResume.editorNewSessionProvider": {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "agy",
            "grok",
            "opencode",
            "pi"
          ],
          "default": "codex",
          "description": "Agent provider started by the editor title bar New Session button."
        },
        "agentResume.claudeResumeMode": {
          "type": "string",
          "enum": [
            "terminal",
            "panel"
          ],
          "default": "panel",
          "description": "How Claude sessions resume from a click or Open Folder and Resume. panel opens the Claude Code VS Code extension; terminal uses the integrated terminal CLI (claude --resume)."
        },
        "agentResume.codexResumeMode": {
          "type": "string",
          "enum": [
            "terminal",
            "panel",
            "app"
          ],
          "default": "terminal",
          "description": "How Codex sessions resume from a click or Open Folder and Resume. terminal uses the integrated terminal CLI; panel uses the Codex VS Code extension (experimental); app uses Codex App."
        },
        "agentResume.codexIdePanelResume.enabled": {
          "type": "boolean",
          "default": true,
          "description": "[Experimental] Enable Resume in Codex IDE Panel. Set to false to disable immediately if a Codex extension update breaks panel resume."
        },
        "agentResume.codexIdePanelResume.implementationVersion": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 99,
          "description": "[Experimental] Must match the Codex IDE panel integration version built into Agent Resume Panel (currently 1). Lower this only after updating the extension code for a new Codex routing scheme."
        },
        "agentResume.llm.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API base URL for session summarize and auto-rename."
        },
        "agentResume.llm.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model name for session summarize and auto-rename. Prefer a fast, inexpensive model when possible (e.g. gpt-4o-mini, deepseek-chat)."
        },
        "agentResume.llm.outputLanguage": {
          "type": "string",
          "enum": [
            "English",
            "Chinese",
            "Japanese",
            "Korean",
            "Spanish",
            "French",
            "German",
            "Portuguese",
            "Italian",
            "Russian"
          ],
          "default": "English",
          "description": "Language used for Summarize and Auto Rename results."
        },
        "agentResume.llm.maxContextChars": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "maximum": 500000,
          "description": "Maximum characters of conversation sent to the LLM."
        },
        "agentResume.projectMenu.mainActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "favorite",
              "openProject",
              "openInGhostty",
              "newCodexSession",
              "newClaudeSession",
              "newAgySession",
              "newGrokSession",
              "newOpenCodeSession",
              "newPiSession",
              "newAlmaSession",
              "newCodexAppSession"
            ]
          },
          "default": [
            "newCodexSession",
            "newClaudeSession"
          ],
          "description": "Project context menu items shown outside Show More. Open Folder is always visible."
        }
      }
    },
    "commands": [
      {
        "command": "agentResume.refresh",
        "title": "Refresh",
        "category": "Agent Resume",
        "icon": "$(refresh)"
      },
      {
        "command": "agentResume.search",
        "title": "Search Sessions",
        "category": "Agent Resume",
        "icon": "$(search)"
      },
      {
        "command": "agentResume.newSession",
        "title": "New Session",
        "category": "Agent Resume",
        "icon": "$(plus)"
      },
      {
        "command": "agentResume.newSessionFromEditor",
        "title": "New Session",
        "category": "Agent Resume",
        "icon": {
          "light": "resources/icon.png",
          "dark": "resources/icon.png"
        }
      },
      {
        "command": "agentResume.openSession",
        "title": "Resume Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.copyResumeCommand",
        "title": "Copy Resume Command",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.openFolder",
        "title": "Open Folder",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.openProject",
        "title": "Open Folder and Resume",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.openInGhostty",
        "title": "Open in Ghostty",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.openInCodexApp",
        "title": "Resume in Codex App",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.openInClaudeCodePanel",
        "title": "Resume in Claude Code Panel",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.openInCodexIdePanel",
        "title": "Resume in Codex IDE Panel (Experimental)",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.newCodexSession",
        "title": "New Codex Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.newClaudeSession",
        "title": "New Claude Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.newAgySession",
        "title": "New Antigravity Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.newGrokSession",
        "title": "New Grok Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.newOpenCodeSession",
        "title": "New OpenCode Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.newPiSession",
        "title": "New Pi Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.newAlmaSession",
        "title": "New Alma Thread",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.newCodexAppSession",
        "title": "New Codex App Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.favoriteProject",
        "title": "Add to Favorites",
        "category": "Agent Resume",
        "icon": "$(star-empty)"
      },
      {
        "command": "agentResume.unfavoriteProject",
        "title": "Remove from Favorites",
        "category": "Agent Resume",
        "icon": "$(star-full)"
      },
      {
        "command": "agentResume.configureProjectMenu",
        "title": "Customize Project Menu",
        "category": "Agent Resume",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentResume.renameSession",
        "title": "Rename Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.previewSession",
        "title": "Preview Session",
        "category": "Agent Resume"
      },
      {
        "command": "agentResume.openSettings",
        "title": "Agent Resume Settings",
        "category": "Agent Resume",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentResume.autoRenameSession",
        "title": "Auto Rename Session",
        "category": "Agent Resume"
      }
    ],
    "submenus": [
      {
        "id": "agentResume.projectMore",
        "label": "Show More"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentResume",
          "title": "Agent Resume",
          "icon": "resources/agent-resume.svg"
        }
      ]
    },
    "views": {
      "agentResume": [
        {
          "id": "agentResume.sessions",
          "name": "Sessions",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "agentResume.newSessionFromEditor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "agentResume.openSession",
          "when": "false"
        },
        {
          "command": "agentResume.copyResumeCommand",
          "when": "false"
        },
        {
          "command": "agentResume.openFolder",
          "when": "false"
        },
        {
          "command": "agentResume.openProject",
          "when": "false"
        },
        {
          "command": "agentResume.openInGhostty",
          "when": "false"
        },
        {
          "command": "agentResume.openInCodexApp",
          "when": "false"
        },
        {
          "command": "agentResume.openInClaudeCodePanel",
          "when": "false"
        },
        {
          "command": "agentResume.openInCodexIdePanel",
          "when": "false"
        },
        {
          "command": "agentResume.newCodexSession",
          "when": "false"
        },
        {
          "command": "agentResume.newClaudeSession",
          "when": "false"
        },
        {
          "command": "agentResume.newAgySession",
          "when": "false"
        },
        {
          "command": "agentResume.newGrokSession",
          "when": "false"
        },
        {
          "command": "agentResume.newOpenCodeSession",
          "when": "false"
        },
        {
          "command": "agentResume.newPiSession",
          "when": "false"
        },
        {
          "command": "agentResume.newAlmaSession",
          "when": "false"
        },
        {
          "command": "agentResume.newCodexAppSession",
          "when": "false"
        },
        {
          "command": "agentResume.favoriteProject",
          "when": "false"
        },
        {
          "command": "agentResume.unfavoriteProject",
          "when": "false"
        },
        {
          "command": "agentResume.configureProjectMenu",
          "when": "false"
        },
        {
          "command": "agentResume.renameSession",
          "when": "false"
        },
        {
          "command": "agentResume.previewSession",
          "when": "false"
        },
        {
          "command": "agentResume.openSettings",
          "when": "false"
        },
        {
          "command": "agentResume.autoRenameSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentResume.newSession",
          "when": "view == agentResume.sessions",
          "group": "navigation@0"
        },
        {
          "command": "agentResume.search",
          "when": "view == agentResume.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentResume.refresh",
          "when": "view == agentResume.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentResume.openSettings",
          "when": "view == agentResume.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentResume.favoriteProject",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.favorite",
          "group": "navigation@0"
        },
        {
          "command": "agentResume.unfavoriteProject",
          "when": "view == agentResume.sessions && viewItem == agentResume.project.favorited && agentResume.projectMenu.main.favorite",
          "group": "navigation@0"
        },
        {
          "command": "agentResume.openSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.session\\.(codex|claude|agy|grok|opencode|pi)/",
          "group": "inline@1"
        },
        {
          "command": "agentResume.copyResumeCommand",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.session\\.(codex|claude|agy|grok|opencode|pi)/",
          "group": "navigation@0"
        },
        {
          "command": "agentResume.openProject",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.session\\.(codex|claude|agy|grok|opencode|pi)/",
          "group": "navigation@1"
        },
        {
          "command": "agentResume.openInGhostty",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.session\\.(codex|claude|agy|grok|opencode|pi)/",
          "group": "navigation@2"
        },
        {
          "command": "agentResume.previewSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.session\\./",
          "group": "navigation@3"
        },
        {
          "command": "agentResume.renameSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.session\\./",
          "group": "navigation@4"
        },
        {
          "command": "agentResume.autoRenameSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.session\\./",
          "group": "navigation@4.5"
        },
        {
          "command": "agentResume.openInCodexApp",
          "when": "view == agentResume.sessions && viewItem == agentResume.session.codex",
          "group": "navigation@5"
        },
        {
          "command": "agentResume.openInClaudeCodePanel",
          "when": "view == agentResume.sessions && viewItem == agentResume.session.claude",
          "group": "navigation@5"
        },
        {
          "command": "agentResume.openInCodexIdePanel",
          "when": "view == agentResume.sessions && viewItem == agentResume.session.codex && agentResume.codexIdePanelResume.enabled",
          "group": "navigation@5"
        },
        {
          "command": "agentResume.openFolder",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/",
          "group": "navigation@1"
        },
        {
          "command": "agentResume.openProject",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.openProject",
          "group": "navigation@2"
        },
        {
          "command": "agentResume.openInGhostty",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.openInGhostty",
          "group": "navigation@3"
        },
        {
          "command": "agentResume.newCodexSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.newCodexSession",
          "group": "navigation@4"
        },
        {
          "command": "agentResume.newClaudeSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.newClaudeSession",
          "group": "navigation@5"
        },
        {
          "command": "agentResume.newAgySession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.newAgySession",
          "group": "navigation@6"
        },
        {
          "command": "agentResume.newGrokSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.newGrokSession",
          "group": "navigation@7"
        },
        {
          "command": "agentResume.newOpenCodeSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.newOpenCodeSession",
          "group": "navigation@8"
        },
        {
          "command": "agentResume.newPiSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.newPiSession",
          "group": "navigation@9"
        },
        {
          "command": "agentResume.newAlmaSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.newAlmaSession",
          "group": "navigation@10"
        },
        {
          "command": "agentResume.newCodexAppSession",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && agentResume.projectMenu.main.newCodexAppSession",
          "group": "navigation@11"
        },
        {
          "submenu": "agentResume.projectMore",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/",
          "group": "navigation@50"
        }
      ],
      "agentResume.projectMore": [
        {
          "command": "agentResume.favoriteProject",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && !agentResume.projectMenu.main.favorite",
          "group": "navigation@0"
        },
        {
          "command": "agentResume.unfavoriteProject",
          "when": "view == agentResume.sessions && viewItem == agentResume.project.favorited && !agentResume.projectMenu.main.favorite",
          "group": "navigation@0"
        },
        {
          "command": "agentResume.openProject",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && !agentResume.projectMenu.main.openProject",
          "group": "navigation@2"
        },
        {
          "command": "agentResume.openInGhostty",
          "when": "view == agentResume.sessions && viewItem =~ /agentResume\\.project/ && !agentResume.projectMenu.main.openInGhostty",
          "group": "navigation@3"
        },
        {
